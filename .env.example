# ── Binance Futures (data-only, no keys needed for public WS) ──────────────────
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret

# ── WEEX Futures (execution exchange) ─────────────────────────────────────────
WEEX_API_KEY=your_weex_api_key
WEEX_API_SECRET=your_weex_api_secret
WEEX_PASSPHRASE=your_weex_passphrase

# ── Trading pairs (comma-separated, no spaces) ────────────────────────────────
TRADING_PAIRS=BTCUSDT,ETHUSDT,SOLUSDT

# ── Risk parameters ───────────────────────────────────────────────────────────
ACCOUNT_BALANCE_USDT=1000.0          # Capital allocated to the bot
RISK_PER_TRADE_PCT=0.5               # % of balance risked per trade
MAX_OPEN_POSITIONS=3                 # Maximum concurrent positions
LEVERAGE=10                          # Futures leverage

# ── Signal thresholds ─────────────────────────────────────────────────────────
LATENCY_THRESHOLD_PCT=0.08           # Min price spread % to trigger (e.g. 0.08%)
VOLUME_SPIKE_MULTIPLIER=3.0          # Volume must be X× the rolling average
TICK_REPETITION_WINDOW=1.0           # Seconds to analyse tick repetition
TICK_REPETITION_MIN_COUNT=5          # Min repeated ticks to detect bot activity

# ── Position management ───────────────────────────────────────────────────────
BREAKEVEN_TRIGGER_PCT=0.15           # Move SL to entry when profit >= X%
TRAILING_STOP_PCT=0.12               # Trailing distance %
EMERGENCY_EXIT_SPREAD_PCT=0.02       # Close if spread collapses below X%
MAX_TRADE_DURATION_SEC=30            # Hard time-limit per trade

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR
LOG_FILE=logs/scalper.log

# ═══════════════════════════════════════════════════════════════════════════════
# POLYMARKET AI AGENT (python polymarket_main.py)
# ═══════════════════════════════════════════════════════════════════════════════

# ── Safety ────────────────────────────────────────────────────────────────────
DRY_RUN=true                         # true = log only, no real orders sent

# ── Polymarket wallet (Polygon mainnet) ───────────────────────────────────────
POLY_PRIVATE_KEY=0x_your_polygon_wallet_private_key

# ── Polymarket CLOB API credentials ──────────────────────────────────────────
# Generate with: python tools/generate_poly_creds.py
POLY_API_KEY=your_clob_api_key
POLY_API_SECRET=your_clob_api_secret
POLY_API_PASSPHRASE=your_clob_api_passphrase

# ── MiroFish (must be running: docker compose up -d in MiroFish dir) ──────────
MIROFISH_URL=http://localhost:5001   # MiroFish backend URL

# LLM for MiroFish (OpenAI-compatible endpoint)
# Option A: Alibaba Qwen (recommended by MiroFish authors, generous free tier)
#   Sign up: https://bailian.aliyun.com → get API key → paste below
LLM_API_KEY=your_qwen_or_openai_api_key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# Option B: Google Gemini (via OpenAI-compatible endpoint)
#   Sign up: https://aistudio.google.com → Get API key
# LLM_API_KEY=your_gemini_api_key
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL_NAME=gemini-2.0-flash

# Option C: Groq (free tier, very fast)
# LLM_API_KEY=your_groq_api_key
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL_NAME=llama-3.3-70b-versatile

# Zep Cloud (MiroFish memory/graph storage) – free tier: https://getzep.com
ZEP_API_KEY=your_zep_cloud_api_key

# ── Agent parameters ──────────────────────────────────────────────────────────
POLY_MIN_EDGE_PCT=5.0                # Minimum EV edge % to place a bet
POLY_MAX_POSITIONS=10                # Max simultaneous open positions
POLY_SCAN_INTERVAL=1800              # Seconds between market scans (30 min)
POLY_SIM_ROUNDS=10                   # MiroFish simulation rounds per market
POLY_MIN_VOLUME=500                  # Min 24h volume USD to consider a market
POLY_MIN_LIQUIDITY=200               # Min liquidity USD
POLY_MIN_BET_USDC=1.0               # Minimum bet (Polymarket minimum is ~$1)
POLY_MAX_BET_FRACTION=0.05          # Max % of bankroll per single bet
POLY_KELLY_FRACTION=0.25            # Quarter-Kelly (conservative sizing)
POLY_MAX_SCAN_MARKETS=20            # Max markets to evaluate per cycle
