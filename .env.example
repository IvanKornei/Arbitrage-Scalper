# ── Binance Futures (data-only, no keys needed for public WS) ──────────────────
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret

# ── WEEX Futures (execution exchange) ─────────────────────────────────────────
WEEX_API_KEY=your_weex_api_key
WEEX_API_SECRET=your_weex_api_secret
WEEX_PASSPHRASE=your_weex_passphrase

# ── Trading pairs (comma-separated, no spaces) ────────────────────────────────
TRADING_PAIRS=BTCUSDT,ETHUSDT,SOLUSDT

# ── Risk parameters ───────────────────────────────────────────────────────────
ACCOUNT_BALANCE_USDT=1000.0          # Capital allocated to the bot
RISK_PER_TRADE_PCT=0.5               # % of balance risked per trade
MAX_OPEN_POSITIONS=3                 # Maximum concurrent positions
LEVERAGE=10                          # Futures leverage

# ── Signal thresholds ─────────────────────────────────────────────────────────
LATENCY_THRESHOLD_PCT=0.08           # Min price spread % to trigger (e.g. 0.08%)
VOLUME_SPIKE_MULTIPLIER=3.0          # Volume must be X× the rolling average
TICK_REPETITION_WINDOW=1.0           # Seconds to analyse tick repetition
TICK_REPETITION_MIN_COUNT=5          # Min repeated ticks to detect bot activity

# ── Position management ───────────────────────────────────────────────────────
BREAKEVEN_TRIGGER_PCT=0.15           # Move SL to entry when profit >= X%
TRAILING_STOP_PCT=0.12               # Trailing distance %
EMERGENCY_EXIT_SPREAD_PCT=0.02       # Close if spread collapses below X%
MAX_TRADE_DURATION_SEC=30            # Hard time-limit per trade

# ── Advanced signal tuning ────────────────────────────────────────────────────
SIGNAL_COOLDOWN_SEC=2.0              # Min seconds between signals per symbol
BINANCE_BOOK_MAX_STALE_MS=500        # Reject signal if Binance book is older (ms)
WEEX_BOOK_MAX_STALE_MS=1000          # Reject signal if WEEX book is older (ms)
VOLUME_LOOKBACK_BARS=20              # Rolling window size for volume average

# ── Execution ─────────────────────────────────────────────────────────────────
MONITOR_INTERVAL_SEC=0.1             # Stop-evaluation frequency per open trade

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR
LOG_FILE=logs/scalper.log
